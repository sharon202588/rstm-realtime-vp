# RSTM-SP 环境变量配置模板
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 填入实际的API密钥
# 3. 确保 .env 文件已添加到 .gitignore（不要提交到版本控制）

# ============================================
# 豆包评分器API配置（REST API）
# ============================================
# 用于CPAS评分判断，使用 doubao-seed-2-0-lite-260428 模型
# 获取方式：火山引擎控制台 -> API Key 管理
# 你的API Key：从火山方舟控制台获取
ARK_API_KEY=your_ark_api_key_here

# ============================================
# 豆包语音模型API配置（WebSocket API）
# ============================================
# 用于实时语音交互，使用端到端实时语音大模型
# 端到端实时对话：填写新开通模型对应的 APP ID 与接入 Key
DOUBAO_REALTIME_APP_ID=your_app_id_here

DOUBAO_REALTIME_ACCESS_KEY=your_realtime_access_key_here

# Secret Key 不用于该实时对话 WebSocket 数据接口，不要写入本项目

# ============================================
# RSTM状态持久化配置（可选）
# ============================================
# 如果设置，RSTM状态将保存到此文件
# 如果不设置，状态仅在内存中保存
RSTM_STATE_FILE=dialogue_state.json

# ============================================
# 日志配置（可选）
# ============================================
# 日志级别：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志文件路径（可选，如果不设置则输出到控制台）
LOG_FILE=rstm_sp.log


# 火山方已开通的评分模型或推理端点ID
DOUBAO_GRADER_MODEL=your_grader_endpoint_or_model_id

DOUBAO_API_ENDPOINT=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
